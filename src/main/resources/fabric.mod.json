{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}+BTW-${btw_version}",
  "name": "${name}",
  "description": "Client enhancement addon for Better Than Wolves",
  "authors": [
    "jeffyjamzhd"
  ],
  "contact": {
    "homepage": "https://legacyfabric.net/",
    "sources": "https://github.com/Legacy-Fabric/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "custom": {
    "btw:addon_prefix": "EX"
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "${minecraft_version}",
    "btw": ">=${btw_version}"
  }
}
